rules_version = '2';
// Darkime: Regeln für die Firestore-Datenbank.
// Einfach komplett in Firebase einfügen (Firestore Database > Regeln) und veröffentlichen.
// Du musst nichts ändern: Das erste Konto, das sich auf der Seite als Spielleiter anmeldet,
// wird automatisch der Spielleiter. Alle anderen Konten bleiben Gäste.
service cloud.firestore {
  match /databases/{database}/documents {
    function ownerPath() {
      return /databases/$(database)/documents/admin/owner;
    }
    function isAdmin() {
      return request.auth != null
        && exists(ownerPath())
        && get(ownerPath()).data.uid == request.auth.uid;
    }

    // Wer der Spielleiter ist. Kann nur einmal festgelegt werden.
    match /admin/owner {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Spielleiter-Daten (Turnier-Passwort). Nur für den Spielleiter.
    match /admin/config {
      allow read, write: if isAdmin();
    }
    // Code des Dauerlinks. Nur für den Spielleiter.
    match /admin/invite {
      allow read, write: if isAdmin();
    }

    // Einladungslinks: ein Zufallscode zeigt 24 Stunden lang auf einen Raum. Danach ist er nicht mehr lesbar.
    // Ausnahme: der Dauerlink des Spielleiters (perm) läuft erst im Jahr 2100 ab.
    // Anlegen kann ihn nur, wer die Raum-ID schon kennt (also schon drin ist); auflisten kann niemand.
    match /invites/{id} {
      allow get: if resource.data.exp > request.time.toMillis();
      allow list: if false;
      allow create: if id.size() >= 24 && id.size() <= 64
        && request.resource.data.keys().hasOnly(['r', 'exp', 'ts', 'perm'])
        && request.resource.data.r is string && request.resource.data.r.size() <= 64
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.r))
        && request.resource.data.exp is number
        && (request.resource.data.exp <= request.time.toMillis() + 86400000 + 120000
            || (isAdmin() && request.resource.data.get('perm', false) == true));
      // Dauerlink: nur der Spielleiter darf ihn auf einen neuen Server (nach Passwortwechsel) umstellen.
      allow update: if isAdmin() && request.resource.data.keys().hasOnly(['r', 'exp', 'ts', 'perm'])
        && request.resource.data.r is string && request.resource.data.r.size() <= 64;
      allow delete: if isAdmin();
    }

    // Ein Turnier-Raum. Seine ID kennt nur, wer das Turnier-Passwort hat.
    match /rooms/{room} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();

      // Gäste dürfen eigene Spieler anlegen (Name, Farbe, kleines Foto, Schrift, Farbverlauf, Rahmen, Spruch)
      // und später selbst ändern: Nur das Gerät, das den geheimen Schlüssel kennt, dessen SHA-256-Wert in kh steht.
      // Beim Ändern zeigt es den Schlüssel vor (kp) und legt einen neuen kh fest. Siege, Datum usw. bleiben unberührt.
      function playerOk(d) {
        return d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && d.color is string && d.color.size() <= 9
          && d.avatar is string && d.avatar.size() < 60000
          && (!('font' in d) || (d.font is string && d.font.size() <= 20))
          && (!('grad' in d) || (d.grad is string && d.grad.size() <= 20))
          && (!('frame' in d) || (d.frame is string && d.frame.size() <= 20))
          && (!('motto' in d) || (d.motto is string && d.motto.size() <= 40));
      }
      match /players/{id} {
        allow read: if true;
        allow create: if isAdmin() || (
          request.resource.data.keys().hasOnly(['name', 'color', 'avatar', 'createdAt', 'byGuest', 'font', 'grad', 'frame', 'motto', 'kh'])
          && playerOk(request.resource.data)
          && request.resource.data.createdAt is number
          && request.resource.data.byGuest == true
          && (!('kh' in request.resource.data) || (request.resource.data.kh is string && request.resource.data.kh.size() == 64))
        );
        // Der Spielleiter darf alles ändern, nur einen vorhandenen Schlüssel (kh) nicht austauschen.
        allow update: if (isAdmin() && (resource.data.get('kh', '') == '' || request.resource.data.get('kh', '') == resource.data.get('kh', ''))) || (
          'kh' in resource.data
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'color', 'avatar', 'font', 'grad', 'frame', 'motto', 'kh', 'kp'])
          && request.resource.data.kp is string && request.resource.data.kp.size() <= 100
          && hashing.sha256(request.resource.data.kp).toHexString().lower() == resource.data.kh
          && request.resource.data.kh is string && request.resource.data.kh.size() == 64
          && request.resource.data.kh != resource.data.kh
          && playerOk(request.resource.data)
        ) || (
          // Ältere Gast-Spieler ohne Schlüssel bekommen beim ersten Bearbeiten einen.
          !('kh' in resource.data) && resource.data.byGuest == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kh'])
          && request.resource.data.kh is string && request.resource.data.kh.size() == 64
        );
        allow delete: if isAdmin();
      }

      // Gäste dürfen im Quiz antworten (auch Schätzwerte) und Felder wählen.
      match /answers/{id} {
        allow read: if true;
        allow create, update: if isAdmin() || (
          request.resource.data.keys().hasOnly(['qkey', 'pid', 'choice', 'value', 'ts'])
          && request.resource.data.qkey is string
          && request.resource.data.qkey.size() < 120
          && request.resource.data.pid is string
          && request.resource.data.pid.size() < 60
          && request.resource.data.choice is int
          && request.resource.data.choice >= 0
          && request.resource.data.choice <= 59
          && request.resource.data.ts is number
          && (!('value' in request.resource.data) || request.resource.data.value is number)
        );
        allow delete: if isAdmin();
      }

      // Spieleliste: Gäste dürfen Spiele vorschlagen. Ändern und Löschen nur der Spielleiter.
      match /games/{id} {
        allow read: if true;
        allow create: if isAdmin() || (
          request.resource.data.keys().hasOnly(['name', 'status', 'plat', 'genre', 'mode', 'pmin', 'pmax', 'mins', 'note', 'img', 'byGuest', 'by', 'createdAt', 'order'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.status == 'vorschlag'
          && request.resource.data.byGuest == true
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 300))
          && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() < 60000))
          && (!('by' in request.resource.data) || (request.resource.data.by is string && request.resource.data.by.size() <= 40))
        );
        allow update, delete: if isAdmin();
      }

      // Hype für Spiele: jeder darf geben und zurücknehmen.
      match /gvotes/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['gid', 'voter', 'ts'])
          && request.resource.data.gid is string && request.resource.data.gid.size() <= 40
          && request.resource.data.voter is string && request.resource.data.voter.size() <= 40
          && request.resource.data.ts is number;
        allow update: if isAdmin();
        allow delete: if true;
      }

      // Malen: Striche der Zeichnung. Der Zeichner darf auch rückgängig machen.
      match /strokes/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['g', 'n', 'sid', 'c', 'w', 'p', 'f', 'clear', 'ts', 'by'])
          && request.resource.data.g is string && request.resource.data.g.size() <= 60
          && request.resource.data.n is int
          && (!('p' in request.resource.data) || (request.resource.data.p is list && request.resource.data.p.size() <= 420))
          && (!('c' in request.resource.data) || (request.resource.data.c is string && request.resource.data.c.size() <= 9));
        allow update: if isAdmin();
        allow delete: if true;
      }

      // Malen: Tipps, Wortwahl und Daumen hoch.
      match /dacts/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['g', 'pid', 'k', 'v', 'ts'])
          && request.resource.data.g is string && request.resource.data.g.size() <= 60
          && request.resource.data.pid is string && request.resource.data.pid.size() <= 40
          && request.resource.data.k in ['guess', 'choose', 'like']
          && request.resource.data.v is string && request.resource.data.v.size() <= 60
          && request.resource.data.ts is number;
        allow update: if isAdmin();
        allow delete: if true;
      }

      // Spiele-Räume (Quiz, Malen, Golf und Kartenwahn): jeder darf beitreten und als Host das Spiel steuern. Höchstens 8 Spieler pro Raum.
      match /lobbies/{id} {
        allow read: if true;
        allow create, update: if id in ['r1', 'r2', 'r3']
          && request.resource.data.keys().hasOnly(['name', 'members', 'host', 'hostSeen', 'kind', 'quiz', 'draw', 'golf', 'uno', 'hs', 'bots', 'v'])
          && (!('bots' in request.resource.data) || (request.resource.data.bots is map && request.resource.data.bots.size() <= 8))
          && (!('hs' in request.resource.data) || (request.resource.data.hs is map && request.resource.data.hs.size() <= 300))
          && (!('members' in request.resource.data) || (request.resource.data.members is map && request.resource.data.members.size() <= 8));
        allow delete: if isAdmin();
      }

      // Wer gerade online ist: jedes Gerät meldet sich alle 30 Sekunden.
      match /presence/{id} {
        allow read: if true;
        allow create, update: if id.size() <= 60
          && request.resource.data.keys().hasOnly(['ts', 'pid'])
          && request.resource.data.ts is number
          && request.resource.data.pid is string && request.resource.data.pid.size() <= 40;
        allow delete: if true;
      }

      // Malen: Galerie-Bilder, die der Host speichert und beim nächsten Spiel wieder löscht.
      match /dgal/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['gid', 'room', 'turn', 'word', 'd', 'drawer', 'img', 'ts'])
          && request.resource.data.img is string && request.resource.data.img.size() < 120000;
        allow update: if isAdmin();
        allow delete: if true;
      }

      // Videogames: gespielte Spiele im Profil eines Spielers. Eintragen, ändern und löschen darf nur das Gerät, dem der
      // Spieler gehört: Es wechselt im selben Schreibvorgang den geheimen Spieler-Schlüssel (siehe players oben).
      function vgOk(d) {
        return d.keys().hasOnly(['pid', 'title', 'img', 'plat', 'gen', 'md', 'fsk', 'fav', 'hrsp', 'ms', 'mv', 'st', 'ach', 'achU', 'achT', 'r', 'rd', 'hrs', 'note', 'ts', 'up'])
          && d.pid is string && d.pid.size() > 0 && d.pid.size() <= 40
          && d.title is string && d.title.size() > 0 && d.title.size() <= 80
          && (!('img' in d) || (d.img is string && d.img.size() < 60000))
          && (!('plat' in d) || (d.plat is list && d.plat.size() <= 4))
          && (!('gen' in d) || (d.gen is list && d.gen.size() <= 4))
          && (!('md' in d) || (d.md is list && d.md.size() <= 4))
          && (!('st' in d) || d.st in ['done', 'play', 'drop', 'endless'])
          && (!('fsk' in d) || d.fsk in [0, 6, 12, 16, 18])
          && (!('fav' in d) || (d.fav is int && d.fav >= 0 && d.fav <= 3))
          && (!('hrsp' in d) || d.hrsp is bool)
          && (!('ms' in d) || (d.ms is int && d.ms >= 0 && d.ms <= 99))
          && (!('mv' in d) || (d.mv is int && d.mv >= 0 && d.mv <= 99))
          && (!('ach' in d) || d.ach in ['all', 'some', 'none', 'na'])
          && (!('achU' in d) || (d.achU is int && d.achU >= 0 && d.achU <= 9999))
          && (!('achT' in d) || (d.achT is int && d.achT >= 0 && d.achT <= 9999))
          && d.r is int && d.r >= 0 && d.r <= 10
          && (!('rd' in d) || (d.rd is map && d.rd.keys().hasOnly(['gp', 'gfx', 'snd', 'story', 'atmo', 'fun'])))
          && (!('hrs' in d) || (d.hrs is number && d.hrs >= 0 && d.hrs <= 99999))
          && (!('note' in d) || (d.note is string && d.note.size() <= 300));
      }
      // Nur der Spieler selbst, auch nicht der Spielleiter: Im selben Schreibvorgang muss der Spieler-Schlüssel gewechselt
      // werden, und der vorgezeigte alte Schlüssel (kp) muss zum gespeicherten kh passen. Den kennt nur das Gerät des Spielers.
      // Hat ein Spieler noch keinen Schlüssel, darf er (bzw. bei selbst angelegten Spielern der Spielleiter) ihn dabei festlegen.
      function vgPl(pid) { return /databases/$(database)/documents/rooms/$(room)/players/$(pid); }
      function vgOwner(pid) {
        return exists(vgPl(pid)) && ((
            get(vgPl(pid)).data.get('kh', '') != ''
            && getAfter(vgPl(pid)).data.get('kh', '') != get(vgPl(pid)).data.get('kh', '')
            && getAfter(vgPl(pid)).data.get('kp', '') is string
            && hashing.sha256(getAfter(vgPl(pid)).data.get('kp', '')).toHexString().lower() == get(vgPl(pid)).data.get('kh', '')
          ) || (
            get(vgPl(pid)).data.get('kh', '') == ''
            && getAfter(vgPl(pid)).data.get('kh', '') != ''
            && (get(vgPl(pid)).data.get('byGuest', false) == true || isAdmin())
          ));
      }
      match /vg/{id} {
        allow read: if true;
        allow create: if vgOk(request.resource.data) && vgOwner(request.resource.data.pid);
        allow update: if vgOk(request.resource.data) && request.resource.data.pid == resource.data.pid && vgOwner(resource.data.pid);
        allow delete: if vgOwner(resource.data.pid);
      }

      // Videogames: Screenshots, Clips und Clip-Links zu einem Spiel. Nur der Spieler selbst, wie oben.
      function vgGame(gid) { return /databases/$(database)/documents/rooms/$(room)/vg/$(gid); }
      match /vgm/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['gid', 'pid', 'k', 'img', 'url', 'cnt', 'mime', 'dur', 'ts'])
          && request.resource.data.gid is string && request.resource.data.gid.size() <= 40
          && request.resource.data.k in ['shot', 'clip', 'link']
          && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() < 600000))
          && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 300))
          && (!('cnt' in request.resource.data) || (request.resource.data.cnt is int && request.resource.data.cnt <= 12))
          && (!('mime' in request.resource.data) || (request.resource.data.mime is string && request.resource.data.mime.size() <= 40))
          && existsAfter(vgGame(request.resource.data.gid))
          && getAfter(vgGame(request.resource.data.gid)).data.pid == request.resource.data.pid
          && vgOwner(request.resource.data.pid);
        allow update: if false;
        allow delete: if vgOwner(resource.data.pid);
      }
      // Teilstücke hochgeladener Clips (werden erst beim Abspielen geladen).
      match /vgp/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['mid', 'gid', 'pid', 'i', 'd', 'ts'])
          && request.resource.data.mid is string && request.resource.data.mid.size() <= 40
          && request.resource.data.i is int && request.resource.data.i >= 0 && request.resource.data.i < 12
          && request.resource.data.d is string && request.resource.data.d.size() < 1000000
          && existsAfter(vgGame(request.resource.data.gid))
          && getAfter(vgGame(request.resource.data.gid)).data.pid == request.resource.data.pid
          && vgOwner(request.resource.data.pid);
        allow update: if false;
        allow delete: if vgOwner(resource.data.pid);
      }

      // Support-Tickets: lesen alle im Raum. Anlegen, Nachtrag und Zurückziehen nur der Spieler selbst (Schlüsselwechsel
      // wie bei Videogames), Stimmen gibt jeder Spieler nur für sich ab, Status und Antworten setzt der Spielleiter.
      function tkOk(d) {
        return d.keys().hasOnly(['by', 'type', 'area', 'sub', 'hole', 'title', 'desc', 'steps', 'expect', 'why', 'freq', 'sev', 'prio', 'tech', 'nimg', 'status', 'msgs', 'votes', 'vby', 'ts', 'up', 'lastBy'])
          && d.by is string && d.by.size() > 0 && d.by.size() <= 40
          && d.type in ['bug', 'idea', 'improve', 'question', 'other']
          && d.area is string && d.area.size() <= 20
          && (!('sub' in d) || (d.sub is string && d.sub.size() <= 80))
          && d.title is string && d.title.size() > 0 && d.title.size() <= 100
          && d.desc is string && d.desc.size() <= 2000
          && (!('steps' in d) || (d.steps is list && d.steps.size() <= 10))
          && (!('expect' in d) || (d.expect is string && d.expect.size() <= 800))
          && (!('why' in d) || (d.why is string && d.why.size() <= 800))
          && (!('tech' in d) || (d.tech is map && d.tech.size() <= 10))
          && (!('nimg' in d) || (d.nimg is int && d.nimg >= 0 && d.nimg <= 3))
          && d.status in ['open', 'progress', 'done', 'rejected']
          && d.msgs is list && d.msgs.size() <= 80
          && (!('votes' in d) || (d.votes is map && d.votes.size() <= 60));
      }
      match /tickets/{id} {
        allow read: if true;
        allow create: if tkOk(request.resource.data) && request.resource.data.status == 'open'
          && request.resource.data.msgs.size() == 0 && request.resource.data.get('votes', {}).size() == 0
          && request.resource.data.lastBy == 'player'
          && vgOwner(request.resource.data.by);
        allow update: if tkOk(request.resource.data) && request.resource.data.by == resource.data.by && (
            isAdmin()
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['msgs', 'up', 'lastBy'])
                && request.resource.data.msgs.size() == resource.data.msgs.size() + 1
                && request.resource.data.lastBy == 'player'
                && vgOwner(resource.data.by))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'vby'])
                && request.resource.data.vby is string
                && request.resource.data.get('votes', {}).diff(resource.data.get('votes', {})).affectedKeys().hasOnly([request.resource.data.vby])
                && vgOwner(request.resource.data.vby))
          );
        allow delete: if isAdmin() || (resource.data.status == 'open' && vgOwner(resource.data.by));
      }
      // Screenshots zu Tickets (bis zu 3), nur der Spieler selbst beim Anlegen.
      function tkDoc(tid) { return /databases/$(database)/documents/rooms/$(room)/tickets/$(tid); }
      match /tkimg/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['tid', 'by', 'i', 'img', 'ts'])
          && request.resource.data.tid is string && request.resource.data.tid.size() <= 40
          && request.resource.data.i is int && request.resource.data.i >= 0 && request.resource.data.i < 3
          && request.resource.data.img is string && request.resource.data.img.size() < 300000
          && existsAfter(tkDoc(request.resource.data.tid))
          && getAfter(tkDoc(request.resource.data.tid)).data.by == request.resource.data.by
          && vgOwner(request.resource.data.by);
        allow update: if false;
        allow delete: if isAdmin() || vgOwner(resource.data.by);
      }

      // Alles andere (Punkte, Einstellungen, Quiz, Rad, Ankündigungen): lesen alle, ändern nur der Spielleiter.
      // Ausnahme Videogames (vg, vgm, vgp): die ändert nur der Spieler selbst (siehe oben).
      match /{coll}/{id} {
        allow read: if true;
        allow write: if isAdmin() && !(coll in ['vg', 'vgm', 'vgp']);
      }
    }
  }
}
